rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Solução de Segurança: O portfólio precisa ser público (leitura livre),
    // mas a modificação do banco só pode ser feita por usuários/clientes logados.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // WhatsApp sessions (Palácio de Memória contínuo)
    match /whatsapp_sessions/{phoneNumber} {
      allow read, write: if true;
    }
    
    // Contatos Pessoais / Exceções (Leitura livre para o bot validar; gravação por admin/logado)
    match /whatsapp_personal_contacts/{number} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Leads (Criação livre para o webhook registrar novos fechamentos; leitura por logados)
    match /leads/{leadId} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    // Configurações do site / Voz
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
